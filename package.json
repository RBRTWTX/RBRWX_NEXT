{
  "name": "rbrwx-next",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "vite",
    "repo:integrity": "node scripts/repo/verify-integrity.mjs",
    "repo:installer": "node --test scripts/install/framework.test.mjs",
    "weather:audit:test": "node --test scripts/weather-audit/contracts.test.mjs",
    "weather:audit:contracts": "node scripts/weather-audit/contracts.mjs",
    "weather:audit": "node scripts/weather-audit/audit.mjs",
    "map:integrity": "node scripts/validate-payload-manifest.mjs",
    "map:contract": "node scripts/validate-broadcast-contract.mjs",
    "map:style": "gl-style-validate src/map/broadcastMapStyle.json",
    "map:provider": "node scripts/validate-map-provider.mjs",
    "map:provider:test": "node --test scripts/provider-http.test.mjs",
    "native:assets": "node scripts/validate-native-assets.mjs",
    "verify:foundation": "npm run map:integrity && npm run native:assets && npm run map:contract && npm run map:style && npm run map:provider:test",
    "verify:modules": "node scripts/broadcast/verify-broadcast.mjs && node scripts/graphics/verify.mjs && node scripts/current-weather/verify.mjs && node scripts/forecast-graphics/verify.mjs && node scripts/qpf/verify.mjs",
    "verify": "npm run repo:integrity && npm run repo:installer && npm run desktop:test && npm run weather:audit:test && npm run synoptic:test && npm run verify:foundation && npm run verify:modules && npm run typecheck && npm run build",
    "verify:live": "npm run map:provider && npm run weather:audit",
    "typecheck": "tsc -b --pretty false",
    "build": "tsc -b && vite build",
    "tauri": "tauri",
    "synoptic:test": "node --test scripts/synoptic/*.test.mjs",
    "desktop:test": "node --test scripts/desktop/*.test.mjs"
  },
  "dependencies": {
    "@azohra/meteo.grib": "0.1.4",
    "@azohra/meteo.j2k": "0.2.0",
    "@tauri-apps/api": "2.11.1",
    "fast-png": "8.0.0",
    "h5wasm": "0.10.3",
    "maplibre-gl": "6.8.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@maplibre/maplibre-gl-style-spec": "26.4.1",
    "@tauri-apps/cli": "2.11.4",
    "@types/geojson": "7946.0.16",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
