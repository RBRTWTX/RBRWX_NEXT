{
  "name": "@rbrwx/broadcast-graphics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone RBRWX NEXT broadcast title bar, lower third, and ticker package.",
  "engines": {
    "node": ">=22 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./broadcast-graphics.css": "./styles/broadcast-graphics.css",
    "./graphics-menu.css": "./styles/graphics-menu.css"
  },
  "files": [
    "dist",
    "styles",
    "broadcast-graphics-contract.json",
    "README.md"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "contract": "node scripts/validate-contract.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "build": "tsc -p tsconfig.build.json --pretty false",
    "test:run": "node --test tests/*.test.mjs",
    "test": "npm run build && npm run test:run",
    "demo:build": "vite build",
    "verify": "npm run contract && npm run typecheck && npm run build && npm run test:run && npm run demo:build"
  },
  "peerDependencies": {
    "react": ">=19 <20",
    "react-dom": ">=19 <20"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
