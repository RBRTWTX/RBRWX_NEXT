{
  "version": 8,
  "name": "RBRWX Broadcast Basemap Schema v1",
  "metadata": {
    "rbrwx:schema-version": 1,
    "rbrwx:purpose": "broadcast-weather-basemap",
    "rbrwx:weather-insert-before": "rbrwx-county-boundary"
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sprite": "https://tiles.openfreemap.org/sprites/ofm_f384/ofm",
  "sources": {
    "rbrwx-basemap": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet",
      "attribution": "OpenFreeMap © OpenMapTiles © OpenStreetMap contributors"
    },
    "rbrwx-relief": {
      "type": "raster",
      "tiles": [
        "https://tiles.openfreemap.org/natural_earth/ne2sr/{z}/{x}/{y}.png"
      ],
      "tileSize": 256,
      "maxzoom": 6,
      "attribution": "Natural Earth"
    },
    "rbrwx-county-boundaries": {
      "type": "geojson",
      "data": {
        "type": "FeatureCollection",
        "features": []
      }
    },
    "rbrwx-county-labels": {
      "type": "geojson",
      "data": {
        "type": "FeatureCollection",
        "features": []
      }
    },
    "rbrwx-weather-slot": {
      "type": "geojson",
      "data": {
        "type": "FeatureCollection",
        "features": []
      }
    },
    "rbrwx-satellite-basemap": {
      "type": "raster",
      "tiles": [
        "https://basemap.nationalmap.gov/arcgis/rest/services/USGSImageryOnly/MapServer/tile/{z}/{y}/{x}"
      ],
      "tileSize": 256,
      "minzoom": 0,
      "maxzoom": 16,
      "attribution": "USDA, USGS The National Map: Orthoimagery"
    }
  },
  "layers": [
    {
      "id": "rbrwx-background",
      "type": "background",
      "paint": {
        "background-color": "#68725f"
      }
    },
    {
      "id": "rbrwx-satellite-imagery",
      "type": "raster",
      "source": "rbrwx-satellite-basemap",
      "minzoom": 0,
      "maxzoom": 19,
      "layout": {
        "visibility": "none"
      },
      "paint": {
        "raster-opacity": 1,
        "raster-fade-duration": 0
      }
    },
    {
      "id": "rbrwx-relief",
      "type": "raster",
      "source": "rbrwx-relief",
      "maxzoom": 7.2,
      "paint": {
        "raster-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          2,
          0.42,
          5.5,
          0.28,
          7.2,
          0.04
        ],
        "raster-saturation": -0.42,
        "raster-contrast": 0.08,
        "raster-brightness-min": 0.18,
        "raster-brightness-max": 0.78,
        "raster-fade-duration": 0
      }
    },
    {
      "id": "rbrwx-landcover",
      "type": "fill",
      "source": "rbrwx-basemap",
      "source-layer": "landcover",
      "minzoom": 5,
      "filter": [
        "match",
        [
          "get",
          "class"
        ],
        [
          "wood",
          "grass",
          "farmland"
        ],
        true,
        false
      ],
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "class"
          ],
          "wood",
          "#536950",
          "grass",
          "#708266",
          "farmland",
          "#7a8065",
          "#68725f"
        ],
        "fill-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          5,
          0.1,
          12,
          0.2
        ]
      }
    },
    {
